 {
  "page": "https://docs.api.loggi.com/reference/authenticatev2.md",
  "definition": {
   "openapi": "3.0.0",
   "info": {
    "title": "Authentication",
    "version": "v1",
    "description": "Autenticação OAuth2 para acesso às APIs da Loggi."
   },
   "servers": [
    {
     "url": "https://stg.api.loggi.com"
    },
    {
     "url": "https://api.loggi.com"
    }
   ],
   "paths": {
    "/v2/oauth2/token": {
     "post": {
      "tags": [
       "AuthAPI"
      ],
      "summary": "Autenticação V2",
      "description": "Solicitação de token para as APIs da Loggi.",
      "operationId": "AuthenticateV2",
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/ServiceAccountTokenRequest"
         }
        }
       },
       "required": true
      },
      "responses": {
       "200": {
        "description": "Return the JWT Token for the service account",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ServiceAccountTokenResponse"
          }
         }
        }
       },
       "400": {
        "description": "Validation Error",
        "content": {
         "application/problem+json": {
          "schema": {
           "$ref": "#/components/schemas/Problem"
          }
         }
        }
       }
      }
     }
    }
   },
   "components": {
    "schemas": {
     "ServiceAccountTokenRequest": {
      "properties": {
       "client_id": {
        "type": "string",
        "minLength": 1,
        "title": "Client Id"
       },
       "client_secret": {
        "type": "string",
        "minLength": 1,
        "title": "Client Secret"
       }
      },
      "type": "object",
      "required": [
       "client_id",
       "client_secret"
      ],
      "title": "ServiceAccountTokenRequest"
     },
     "ServiceAccountTokenResponse": {
      "properties": {
       "idToken": {
        "type": "string",
        "title": "Idtoken"
       },
       "expiresIn": {
        "type": "string",
        "title": "Expiresin"
       }
      },
      "type": "object",
      "required": [
       "idToken",
       "expiresIn"
      ],
      "title": "ServiceAccountTokenResponse"
     },
     "Problem": {
      "properties": {
       "type": {
        "type": "string",
        "description": "Uma referência de URI que identifica o tipo de problema."
       },
       "title": {
        "type": "string",
        "description": "Um resumo curto e legível para humanos do tipo de problema."
       },
       "status": {
        "type": "integer",
        "description": "O código de status HTTP gerado."
       },
       "detail": {
        "type": "string",
        "description": "Uma explicação legível para humanos específica para esta ocorrência do problema."
       },
       "instance": {
        "type": "string",
        "description": "Uma referência de URI que identifica a ocorrência específica do problema."
       }
      },
      "type": "object"
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "_id": {
    "buffer": {
     "0": 106,
     "1": 85,
     "2": 76,
